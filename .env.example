# DeepSeek API（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MCP 密钥
EXERCISEAPI_KEY=exlib_your_key_here
USDA_API_KEY=your_usda_key_here

# 动作示范图前缀（可选）。exerciseapi 的 images 为相对路径（如 Barbell_Squat/0.jpg），
# 官方不提供固定域名；配置此前缀后拼出完整 URL。留空则计划页只显示演示视频/占位图。
#
# 开箱即用：动作库源自开源 free-exercise-db，可直接用 jsDelivr CDN：
EXERCISEAPI_IMAGE_BASE=https://cdn.jsdelivr.net/gh/yuhonas/free-exercise-db@main/exercises/
# 或用你同步到本地/R2/Pages 的地址（见 scripts/sync_exercise_images.py）

# Ollama 嵌入服务（EMBED_PROVIDER=ollama，默认）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=dengcao/Qwen3-Embedding-8B:Q5_K_M

# 嵌入后端切换：ollama（默认）| openai（OpenAI 兼容旁路，如 llama-server）
EMBED_PROVIDER=ollama
# EMBED_PROVIDER=openai 时生效
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_MODEL_NAME=qwen3-embedding

# 数据库
SQLITE_DB_PATH=./data/app.db
CHROMA_DB_PATH=./data/chroma_db

# 应用配置
LOG_LEVEL=INFO

# 内部服务鉴权
# API_KEY：调用 FastAPI（X-API-Key 请求头）的共享密钥
# APP_PASSWORD：Streamlit 页面登录密码（也写入 .streamlit/secrets.toml）
API_KEY=your_internal_api_key
APP_PASSWORD=your_streamlit_password
